#ifndef RICERCATRAIETTORIAIDEALEOMP_ALGORITMOGENETICO_HPP
#define RICERCATRAIETTORIAIDEALEOMP_ALGORITMOGENETICO_HPP

#include "Traiettoria.hpp"
#include "SezionePista.hpp"
#include "Veicolo.hpp"
#include "GeneraTraiettorie.hpp"
#include "ValutatoreTraiettoria.hpp"

#include <vector>
#include <random>

using namespace std;


// Si occupa di cercare una traiettoria ottimale utilizzando
// un algoritmo genetico.
//
// Ogni individuo della popolazione è rappresentato da una Traiettoria.
//
// Il valore utilizzato per valutare la qualità di una traiettoria
// è il tempo sul giro restituito da ValutatoreTraiettoria.
//
// Un tempo sul giro minore indica quindi una traiettoria migliore.
//
// L'algoritmo procede attraverso diverse generazioni:
//
// 1. generazione della popolazione iniziale
// 2. valutazione degli individui
// 3. selezione dei genitori
// 4. crossover
// 5. mutazione
// 6. elitismo
// 7. creazione della nuova popolazione

class AlgoritmoGenetico {
private:
    // Numero di traiettorie presenti in ogni generazione.
    int dimensionePopolazione;


    // Numero massimo di generazioni da eseguire.
    int numeroGenerazioni;


    // Probabilità con cui viene applicato il crossover
    // tra due genitori.
    //
    // Deve essere compresa tra 0.0 e 1.0.
    double probabilitaCrossover;


    // Probabilità con cui una posizione laterale della
    // traiettoria viene mutata.
    //
    // Deve essere compresa tra 0.0 e 1.0.
    double probabilitaMutazione;


    // Intensità della mutazione.
    //
    // Determina quanto una posizione laterale può essere
    // modificata durante la mutazione.
    double intensitaMutazione;


    // Numero di individui che partecipano alla selezione
    // a torneo.
    int dimensioneTorneo;


    // Numero dei migliori individui che vengono copiati
    // direttamente nella generazione successiva.
    int numeroElite;


    // Generatore di numeri casuali utilizzato per:
    //
    // - selezione
    // - crossover
    // - mutazione
    //
    // Utilizzare un seed permette di ottenere risultati
    // riproducibili.
    mt19937 generatore;


    // Valutatore utilizzato per calcolare il tempo sul giro
    // di ogni traiettoria.
    ValutatoreTraiettoria valutatore;


    // ------------------------------------------------------------
    // VALUTAZIONE
    // ------------------------------------------------------------


    // Valuta tutte le traiettorie presenti nella popolazione.
    //
    // Per ogni individuo viene calcolato il tempo sul giro
    // utilizzando ValutatoreTraiettoria.
    //
    // Il vector restituito contiene un tempo per ogni
    // traiettoria della popolazione.
    //
    // Esempio:
    //
    // popolazione[0] -> tempi[0]
    // popolazione[1] -> tempi[1]
    // popolazione[2] -> tempi[2]
    //
    // Questa funzione sarà successivamente il punto principale
    // da parallelizzare tramite OpenMP.
    vector<double> valutaPopolazione(
        const vector<Traiettoria> &popolazione,
        const vector<SezionePista> &sezioni,
        const Veicolo &veicolo
    ) const;


    // Restituisce l'indice dell'individuo migliore
    // della popolazione.
    //
    // Poiché stiamo minimizzando il tempo sul giro,
    // viene cercato il valore più piccolo nel vector tempi.
    int trovaIndiceMigliore(
        const vector<double> &tempi
    ) const;


    // ------------------------------------------------------------
    // SELEZIONE
    // ------------------------------------------------------------


    // Seleziona un individuo mediante selezione a torneo.
    //
    // Vengono scelti casualmente "dimensioneTorneo"
    // individui dalla popolazione.
    //
    // Tra questi viene restituito quello con il tempo
    // sul giro più basso.
    const Traiettoria &selezionaGenitore(
        const vector<Traiettoria> &popolazione,
        const vector<double> &tempi
    );


    // ------------------------------------------------------------
    // CROSSOVER
    // ------------------------------------------------------------


    // Genera una nuova traiettoria combinando le informazioni
    // contenute in due traiettorie genitore.
    //
    // Le posizioni laterali dei due genitori vengono combinate
    // per generare un nuovo individuo.
    //
    // Il crossover viene applicato secondo la probabilità
    // definita da probabilitaCrossover.
    Traiettoria crossover(
        const Traiettoria &genitore1,
        const Traiettoria &genitore2
    );


    // ------------------------------------------------------------
    // MUTAZIONE
    // ------------------------------------------------------------


    // Applica una mutazione alla traiettoria.
    //
    // Ogni posizione laterale può essere modificata con
    // probabilitaMutazione.
    //
    // La variazione applicata dipende da intensitaMutazione.
    //
    // Dopo la mutazione ogni posizione deve comunque rimanere
    // nell'intervallo:
    //
    // 0.0 <= posizione <= 1.0
    void muta(
        Traiettoria &traiettoria
    );


    // ------------------------------------------------------------
    // ELITISMO
    // ------------------------------------------------------------


    // Copia nella nuova popolazione i migliori individui
    // della generazione corrente.
    //
    // Il numero di individui copiati è determinato
    // da numeroElite.
    void aggiungiElite(
        const vector<Traiettoria> &popolazione,
        const vector<double> &tempi,
        vector<Traiettoria> &nuovaPopolazione
    ) const;


    // ------------------------------------------------------------
    // NUOVA GENERAZIONE
    // ------------------------------------------------------------


    // Genera la popolazione della generazione successiva.
    //
    // Il procedimento è:
    //
    // 1. inserimento degli individui elite
    // 2. selezione dei genitori
    // 3. crossover
    // 4. mutazione
    // 5. inserimento dei nuovi individui
    //
    // La nuova popolazione deve avere sempre dimensione
    // uguale a dimensionePopolazione.
    vector<Traiettoria> generaNuovaPopolazione(
        const vector<Traiettoria> &popolazione,
        const vector<double> &tempi
    );

public:
    // Costruttore dell'algoritmo genetico.
    //
    // Permette di configurare:
    //
    // - dimensione della popolazione
    // - numero di generazioni
    // - probabilità di crossover
    // - probabilità di mutazione
    // - intensità della mutazione
    // - dimensione del torneo
    // - numero di individui elite
    // - seed per la generazione casuale
    //
    // I parametri devono essere validati prima
    // di essere memorizzati.
    AlgoritmoGenetico(
        int dimensionePopolazione,
        int numeroGenerazioni,
        double probabilitaCrossover,
        double probabilitaMutazione,
        double intensitaMutazione,
        int dimensioneTorneo,
        int numeroElite,
        unsigned int seed
    );


    // Esegue l'intero algoritmo genetico.
    //
    // Riceve:
    //
    // - le sezioni della pista
    // - il veicolo utilizzato
    //
    // Procedimento:
    //
    // 1. genera la popolazione iniziale
    // 2. valuta la popolazione
    // 3. individua il migliore
    // 4. genera nuove popolazioni per il numero
    //    di generazioni configurato
    // 5. conserva la migliore traiettoria trovata
    //
    // Restituisce la migliore traiettoria trovata
    // al termine dell'ottimizzazione.
    Traiettoria ottimizza(
        const vector<SezionePista> &sezioni,
        const Veicolo &veicolo
    );


    // Getter dei parametri principali dell'algoritmo.

    int getDimensionePopolazione() const;

    int getNumeroGenerazioni() const;

    double getProbabilitaCrossover() const;

    double getProbabilitaMutazione() const;

    double getIntensitaMutazione() const;

    int getDimensioneTorneo() const;

    int getNumeroElite() const;
};


#endif
